<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Portafolio de Luis Francisco Paria Zúñiga, desarrollador Full Stack." />
    <title>Luis Paria — Full Stack Developer</title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <!-- Esta vista usa el mismo contenido de index.html para permitir servir el portafolio con Express. -->
    <main id="app"></main>
    <script>
      fetch('/index.html').then((response) => response.text()).then((page) => {
        const documentContent = new DOMParser().parseFromString(page, 'text/html');
        document.body.innerHTML = documentContent.body.innerHTML;
        const script = document.createElement('script'); script.src = '/main.js'; document.body.append(script);
      });
    </script>
  </body>
</html>
